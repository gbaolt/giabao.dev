  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/node": "26.6.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "eslint": "10.10.0",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-simple-import-sort": "^13.0.0",
      "typescript": "npm:typescript@6.0.3",
      "typescript-7": "npm:typescript@^7",
      "typescript-eslint": "^8.70.1"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter web",
    "dev:cli": "turbo run dev --filter create-gb-app",
    "build": "turbo run build",
    "start": "turbo run start --filter web",
    "next": "turbo run next --filter web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "capture": "bun run --filter web capture",
    "capture:sync": "bun run --filter web capture:sync",
    "mascot:sync": "bun run --filter web mascot:sync",
    "render:resume": "bun run --filter web render:resume",
    "upgrade:next": "bun run --filter web upgrade:next",
    "upgrade:tailwind": "bun run --filter web upgrade:tailwind",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.2",
    "typescript": "catalog:",
    "typescript-7": "catalog:"
  }
}
