{
  "name": "web",
  "portless": "gbaolt",
  "version": "0.1.0",
  "description": "A minimal, shadcn/ui-inspired dev portfolio.",
  "scripts": {
    "dev": "bun run render:resume && portless gbaolt next dev",
    "build": "bun run render:resume && next build",
    "start": "portless gbaolt next start",
    "next": "bun run build && portless gbaolt next start",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx}\" --cache",
    "typecheck": "bun check && bun check -p tsconfig.test.json",
    "test": "bun test",
    "capture": "bun run --bun ./scripts/capture.mts",
    "capture:sync": "bun run --bun ./scripts/capture-sync.mts",
    "mascot:sync": "bun run --bun ./scripts/mascot-sync.mts",
    "render:resume": "bun run --bun ./scripts/render-resume-pdf.ts",
    "upgrade:next": "npm exec @next/codemod@latest upgrade latest",
    "upgrade:tailwind": "npm exec @tailwindcss/upgrade@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@bprogress/next": "^3.2.12",
    "@date-fns/tz": "^1.4.1",
    "@react-three/fiber": "^9.8.1",
    "@takumi-rs/helpers": "^2.13.7",
    "@tanstack/redact": "^0.2.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "create-gb-app": "workspace:*",
    "date-fns": "^4.1.0",
    "fumadocs-core": "^16.15.7",
    "fumadocs-typescript": "^5.4.0",
    "geist": "^1.7.0",
    "gray-matter": "^4.0.3",
    "jotai": "^3.0.0",
    "libphonenumber-js": "^1.12.42",
    "lucide-react": "^1.16.0",
    "mdast": "^3.0.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "motion": "^13.1.1",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "p5": "^1.9.4",
    "pdfjs-dist": "6.3.289",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.9",
    "react-pdf": "^11.0.0",
    "react-resizable-panels": "^4.12.4",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-code-import": "^1.2.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "schema-dts": "^2.0.0",
