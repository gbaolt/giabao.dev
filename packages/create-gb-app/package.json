{
  "name": "create-gb-app",
  "version": "0.0.0",
  "description": "Scaffold a typed fullstack React app with a working notes domain",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./generate": "./src/generate/public.ts",
    "./preset": "./src/preset.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "bin": {
    "create-gb-app": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test",
    "verify:generated": "bun script/verify-generated.ts",
    "verify:browser": "bun script/verify-browser.ts",
    "typecheck": "bun check",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx}\" --cache",
    "build": "bun script/build.ts",
    "publish:prepare": "bun script/publish.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "playwright": "1.64.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "optionalDependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11"
  }
}
